# Spring Boot reads OS environment variables; it does not load this file by itself.
# Set these variables in your shell or deployment secret store.
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cab_booking_db?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=REPLACE_WITH_LOCAL_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Local development only. Review database changes before using a persistent database.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO

# Generate a unique random signing key of at least 32 bytes; never reuse this placeholder.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000
