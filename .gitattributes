# Normalize source, configuration, documentation, and shell files.
* text=auto
*.md text eol=lf
*.cff text eol=lf
*.java text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Preserve binary build and wrapper artifacts.
*.jar binary
*.class binary
